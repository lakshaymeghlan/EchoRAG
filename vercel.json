{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/"
    },
    "api": {
      "root": ".",
      "entrypoint": "echorag.api:app",
      "excludeFiles": "{frontend/**,bench/**,learn/**,docs/**,index/**,index-small/**,.venv/**,**/__pycache__/**,**/*.pyc,test_*.py,*.md}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
