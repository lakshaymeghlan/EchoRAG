# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# /out/ IS ignored. It was committed for the HF Space (gradio SDK had no build
# step), but that host cannot run us at all now and Vercel builds from source.
# Keeping it committed also shipped a stale bundle with NEXT_PUBLIC_API_URL from
# .env.local — i.e. a production UI pointing at localhost:8000.
# Previous note kept for context: the HF Space (gradio SDK) has no
# build step, so the compiled UI ships in git. Rebuild with `npm run build`.
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
