# Copy to .env and fill in. Never commit .env.

# Required. Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Generation path. Default `none` = extractive only, no model call, no key.
# See AUDIT.md §2.4 — this is a design decision, not a cost saving.
#   none      : extractive answers only (default)
#   local     : small local HF model (loses the deadline race; streams as refinement)
#   anthropic : claude-haiku-4-5 (requires ANTHROPIC_API_KEY)
ECHORAG_GENERATOR=none

# Only read when ECHORAG_GENERATOR=anthropic
ANTHROPIC_API_KEY=
