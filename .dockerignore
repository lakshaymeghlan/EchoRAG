# Never ship these into the image — .venv alone is 1.4 GB.
.venv/
node_modules/
# The whole UI ships to Vercel, not into this image — keep it out of the build
# context so `gcloud run deploy --source .` uploads megabytes, not gigabytes.
frontend/
index/
data/
.git/
__pycache__/
*.pyc
.env
learn/
bench/runs.jsonl
bench/*.png
